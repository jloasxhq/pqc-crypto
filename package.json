{
  "name": "@quxtech/pqc-crypto",
  "version": "2.0.0",
  "description": "Post-Quantum Cryptography library implementing CRYSTALS-Kyber (ML-KEM) and CRYSTALS-Dilithium (ML-DSA) with hybrid KEM, pluggable PqcProvider, opt-in FIPS-mode self-tests, NIST KAT vectors, and signed SBOM",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./kem": {
      "import": "./src/core/kem.js"
    },
    "./dsa": {
      "import": "./src/core/dsa.js"
    },
    "./hybrid": {
      "import": "./src/core/hybrid.js"
    },
    "./symmetric": {
      "import": "./src/core/symmetric.js"
    },
    "./keys": {
      "import": "./src/core/keys.js"
    },
    "./session": {
      "import": "./src/core/session.js"
    },
    "./voip": {
      "import": "./src/core/voip.js"
    },
    "./hash": {
      "import": "./src/utils/hash.js"
    },
    "./fips": {
      "import": "./src/core/fips.js"
    },
    "./provider": {
      "import": "./src/core/provider.js"
    },
    "./selftest": {
      "import": "./src/core/selftest.js"
    },
    "./zeroize": {
      "import": "./src/utils/zeroize.js"
    }
  },
  "files": [
    "src",
    "test/vectors",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "BUILD.md",
    "LICENSE",
    "bom.json",
    "bom.json.sig",
    "bom-pubkey.pem"
  ],
  "scripts": {
    "selftest": "node -e \"import('./src/index.js').then(async m => { await m.runSelfTests(); console.log('self-tests passed'); })\"",
    "verify-sbom": "node scripts/verify-sbom.js"
  },
  "keywords": [
    "post-quantum",
    "cryptography",
    "pqc",
    "ml-kem",
    "ml-dsa",
    "hybrid-kem",
    "kyber",
    "dilithium",
    "x25519",
    "ecdh-p384",
    "fips-203",
    "fips-204",
    "sp-800-56c",
    "quantum-safe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.qux.local:11300/quxadmin/pqc-crypto.git"
  },
  "bugs": {
    "url": "https://git.qux.local:11300/quxadmin/pqc-crypto/issues"
  },
  "homepage": "https://git.qux.local:11300/quxadmin/pqc-crypto",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/hashes": "1.7.1",
    "@noble/post-quantum": "0.2.1",
    "@noble/curves": "1.8.1"
  }
}